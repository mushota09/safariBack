# ============================================
# SAFARI FAST - ENVIRONMENT VARIABLES
# ============================================
# IMPORTANT: Copy this file to .env and fill with your actual values
# NEVER commit .env file to version control!
# ============================================

# Database
# Example: postgresql+asyncpg://user:password@host:port/database?sslmode=require
DATABASE_URL=postgresql+asyncpg://your_user:your_password@your_host:5432/your_database?sslmode=require
DATABASE_ECHO=False

# Redis
# Example: redis://:password@host:port/db
REDIS_URL=redis://:your_redis_password@your_redis_host:6379/0
REDIS_CACHE_TTL=60

# JWT Security
# CRITICAL: Generate a strong random secret key for production!
# Use: openssl rand -hex 32
SECRET_KEY=your_super_secret_key_here_change_this_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_specific_password_here
SMTP_FROM=your_email@gmail.com
SMTP_TLS=True

# Application
APP_NAME=Safari Fast - Réservation de Billets de Bateau
APP_VERSION=1.0.0
DEBUG=False
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,https://your-domain.com

# Réservation
RESERVATION_EXPIRATION_MINUTES=30

# Rate Limiting
RATE_LIMIT_PER_MINUTE=100

# Files
UPLOAD_DIR=uploads
PDF_DIR=pdfs
QR_CODE_DIR=qrcodes

# Paiement (simulateur)
PAIEMENT_SUCCESS_RATE=0.95

# Google OAuth
# Get these from: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
